# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is listed in .gitignore - never commit it, paste it, or screenshot it.

# Your internal integration secret (starts with ntn_). From:
# https://www.notion.so/profile/integrations  -> your integration -> Internal integration secret
NOTION_TOKEN=ntn_replace_with_your_secret

# The page everything is built under. A URL or the 32-character ID both work.
NOTION_PARENT_PAGE=https://app.notion.com/p/Personal-HQ-401dc3e5c72480eabce6dcd3961cdf79
